{
  "name": "viska",
  "version": "2.3.1",
  "type": "module",
  "workspaces": [
    "workspaces/*"
  ],
  "scripts": {
    "lint": "biome check",
    "lint:staged": "biome check --staged --no-errors-on-unmatched",
    "lint:ci": "biome ci",
    "lint:fix": "biome check --write --unsafe",
    "dev": "npm run dev:server & npm run dev:ui",
    "dev:ui": "npm run dev -w @viska/front",
    "dev:server": "npm run dev -w @viska/back",
    "build:ui": "npm run build -w @viska/front",
    "start:server": "npm start -w @viska/back",
    "typecheck": "npm run typecheck -w @viska/back && npm run build -w @viska/front",
    "prepare": "lefthook install || true",
    "test": "echo 'Test passed!'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  }
}
